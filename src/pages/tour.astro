---
import "./styles/styles.css"
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cami Layé Okún – Tour</title>
      <link rel="stylesheet" href="styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap"rel="stylesheet"/>
  </head>

  <body class="page-tour">

    <nav class="top-nav">
      <div class="nav-container">
        <a href="/" class="logo">CAMI LAYÉ OKÚN</a>
        <ul class="nav-links">

          <li><a href="/about">About</a></li>
          <li><a href="/tour" class="active">Tour</a></li>
          <li><a href="/playlist">Playlists</a></li>
        </ul>
      </div>
    </nav>

    <main class="tour-main">
      <section class="tour-hero">
        <h1>Tour Dates</h1>
        <p class="tour-tagline">
          Upcoming shows featuring sunny records, deep cuts and late‑night
          dance‑floor stories.
        </p>
      </section>

      <section class="tour-list-section">
        <h2>Upcoming Shows</h2>
        <div class="tour-list">
          <article class="tour-item">
            <div class="tour-date">
              <span class="tour-day">14</span>
              <span class="tour-month">MAR</span>
              <span class="tour-year">2026</span>
            </div>
            <div class="tour-details">
              <h3>Midnight Grooves at La Fábrica</h3>
              <p class="tour-location">Havana, Cuba</p>
              <p class="tour-note">Intimate extended vinyl set all night long.</p>
            </div>
          </article>

          <article class="tour-item">
            <div class="tour-date">
              <span class="tour-day">29</span>
              <span class="tour-month">APR</span>
              <span class="tour-year">2026</span>
            </div>
            <div class="tour-details">
              <h3>Sunset Session at Rooftop Sol</h3>
              <p class="tour-location">Barcelona, Spain</p>
              <p class="tour-note">
                Warm Caribbean selections as the sun goes down over the city.
              </p>
            </div>
          </article>

          <article class="tour-item">
            <div class="tour-date">
              <span class="tour-day">18</span>
              <span class="tour-month">MAY</span>
              <span class="tour-year">2026</span>
            </div>
            <div class="tour-details">
              <h3>Night Flight at Club Aurora</h3>
              <p class="tour-location">Berlin, Germany</p>
              <p class="tour-note">
                Deep, percussive journey through Afro‑Latin and cosmic disco.
              </p>
            </div>
          </article>

          <article class="tour-item">
            <div class="tour-date">
              <span class="tour-day">07</span>
              <span class="tour-month">JUN</span>
              <span class="tour-year">2026</span>
            </div>
            <div class="tour-details">
              <h3>Riverfront Festival</h3>
              <p class="tour-location">Porto, Portugal</p>
              <p class="tour-note">
                Open‑air festival set blending tropical rhythms and jazz‑infused
                grooves.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section class="tour-list-section past-tour">
        <h2>Past Highlights</h2>
        <div class="tour-list">
          <article class="tour-item">
            <div class="tour-date">
              <span class="tour-day">12</span>
              <span class="tour-month">OCT</span>
              <span class="tour-year">2025</span>
            </div>
            <div class="tour-details">
              <h3>Late Night at Casa del Ritmo</h3>
              <p class="tour-location">Mexico City, Mexico</p>
              <p class="tour-note">
                Packed dance floor with classic Cuban cuts and dusty disco.
              </p>
            </div>
          </article>

          <article class="tour-item">
            <div class="tour-date">
              <span class="tour-day">03</span>
              <span class="tour-month">SEP</span>
              <span class="tour-year">2025</span>
            </div>
            <div class="tour-details">
              <h3>Selector’s Corner at The Loft</h3>
              <p class="tour-location">London, UK</p>
              <p class="tour-note">
                Special all‑vinyl session connecting jazz, soul and Caribbean
                rhythms.
              </p>
            </div>
          </article>
        </div>
      </section>
    </main>


    <footer>
      <div class="social-links">
        <a href="https://www.instagram.com/camilayeokun/" target="_blank" rel="noreferrer">Instagram</a>

        <a href="https://www.facebook.com/camilayeokun/" target="_blank" rel="noreferrer">Facebook</a>
        
        <a href="https://www.nts.live/shows/cami-laye-okun"target="_blank" rel="noreferrer">NTS Radio</a>
        
        <a href="https://soundcloud.com/camila-garc-a-valent-n" target="_blank" rel="noreferrer">SoundCloud</a>

      </div>

      <div>
        <p>&copy; 2025 Cami Layé Okún. All Rights Reserved.</p>
      </div>
    </footer>
  </body>
</html>