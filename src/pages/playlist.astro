---
import "../styles/styles.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cami Layé Okún – Playlists & Mixes</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mrs+Sheppards&display=swap"
      rel="stylesheet"/>
  </head>

  <body class="page-playlist">
    <nav class="top-nav">
      <div class="nav-container">
        <a href="/" class="logo">Cami Layé Okún</a>

        <ul class="nav-links">
          <li><a href="/about">About</a></li>

          <li><a href="/tour">Tour</a></li>

          <li><a href="/playlist" class="active">Playlists</a></li>

        </ul>
      </div>
    </nav>

    <main class="playlists-main">
      <section class="playlists-hero">
        <div class="playlists-hero-inner">
          <h1>SESSIONS</h1>
          <p>
            A selection of Cami’s vinyl mixes, plus your own additions to
            the playlist:
          </p>
        </div>
      </section>

      <section class="mixes-section">

        <div class="playlist-controls">
          <button id="shuffle-btn" type="button">Shuffle playlist</button>
        </div>

        <ul id="playlist-list"></ul>

        <form id="playlist-form">
          <input
            type="text"
            id="song-input"
            placeholder="Add a song title"
            required/>
          <button type="submit">Add song</button>
        </form>
      </section>
    </main>

    <footer>
      <div class="social-links">
        <a
          href="https://www.instagram.com/camilayeokun/"
          target="_blank"
          rel="noreferrer"
          >Instagram</a>

        <a
          href="https://www.facebook.com/camilayeokun/"
          target="_blank"
          rel="noreferrer"
          >Facebook</a>

        <a
          href="https://www.nts.live/shows/cami-laye-okun"
          target="_blank"
          rel="noreferrer"
          >NTS Radio</a>

        <a
          href="https://soundcloud.com/camila-garc-a-valent-n"
          target="_blank"
          rel="noreferrer"
          >SoundCloud</a>
      </div>

      <div>
        <p>&copy; 2025 Cami Layé Okún. All Rights Reserved.</p>
      </div>
    </footer>

      <script src="/playlist.js" is:inline></script>
  </body>
</html>
