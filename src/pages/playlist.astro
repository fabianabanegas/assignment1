---
import "./styles/styles.css"
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cami Layé Okún – Playlists & Mixes</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet"/>
  </head>

  <body class="page-playlists">
    <nav class="top-nav">
      <div class="nav-container">
        <a href="/" class="logo">CAMI LAYÉ OKÚN</a>
        <ul class="nav-links">
          <li><a href="/about">About</a></li>
          <li><a href="/tour">Tour</a></li>
          <li><a href="/playlist" class="active">Playlists</a></li>
        </ul>
      </div>
    </nav>

    <main class="playlists-main">
      <section class="playlists-hero">
        <div class="playlists-hero-inner">
          <h1>Playlists & Mixes</h1>
          <p>
            A selection of Cami Layé Okún’s sunny vinyl journeys – from
            Afro‑Cuban grooves to tropical disco and beyond.
          </p>
        </div>
      </section>

      <section class="mixes-section">
        <div class="mixes-grid">
          <article class="mix-card">
            <div class="mix-tag">Radio Show</div>
            <h2>Insolar – NTS Radio</h2>
            <p class="mix-description">
              Fortnightly show on NTS, exploring Afro‑Cuban rhythms, Caribbean
              gems and sun‑drenched global grooves.
            </p>
            <p class="mix-meta">Platform: NTS Radio</p>
            <a class="mix-button" href="https://www.nts.live/shows/cami-laye-okun"target="_blank"rel="noreferrer">Listen on NTS</a>
          </article>


          <article class="mix-card">
            <div class="mix-tag">YouTube Mix</div>
            <h2>Afro Cuban Funky Grooves</h2>
            <p class="mix-description">
              A vinyl‑only session packed with funky Cuban cuts, percussive
              workouts and deep dance‑floor selections.
            </p>
            <p class="mix-meta">Platform: YouTube</p>
            <a class="mix-button" href="https://www.youtube.com/watch?v=YC7faDixT9A"target="_blank"
              rel="noreferrer">Watch on YouTube</a>
          </article>


          <article class="mix-card">
            <div class="mix-tag">Radio Archive</div>
            <h2>Insolar – Recent Episode</h2>
            <p class="mix-description">
              A recent edition of Insolar, blending vintage Latin records,
              spiritual jazz and diasporic sounds.
            </p>
            <p class="mix-meta">Platform: NTS Archive</p>
            <a
              class="mix-button"
              href="https://soundcloud.com/user-643553014/insolar-w-cami-laye-798762481"
              target="_blank"
              rel="noreferrer"
              >Listen to episode</a
            >
          </article>


          <article class="mix-card">
            <div class="mix-tag">SoundCloud</div>
            <h2>Selected Sets & Guest Mixes</h2>
            <p class="mix-description">
              A growing collection of guest mixes and live recordings from clubs
              and festivals around the world.
            </p>
            <p class="mix-meta">Platform: SoundCloud</p>
            <a
              class="mix-button"
              href="https://soundcloud.com/camila-garc-a-valent-n"target="_blank" rel="noreferrer">Visit SoundCloud</a>
          </article>
        </div>
      </section>
    </main>



    <footer>
      <div class="social-links">
        <a href="https://www.instagram.com/camilayeokun/" target="_blank" rel="noreferrer">Instagram</a>

        <a href="https://www.facebook.com/camilayeokun/" target="_blank" rel="noreferrer">Facebook</a>
        
        <a href="https://www.nts.live/shows/cami-laye-okun"target="_blank" rel="noreferrer">NTS Radio</a>
        
        <a href="https://soundcloud.com/camila-garc-a-valent-n" target="_blank" rel="noreferrer">SoundCloud</a>

      </div>

      <div>
        <p>&copy; 2025 Cami Layé Okún. All Rights Reserved.</p>
      </div>
    </footer>
  </body>
</html>
